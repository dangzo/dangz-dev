    "ci": "yarn lint && yarn typecheck && yarn build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "generate-types": "sanity schema extract && sanity typegen generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/code-input": "^7.1.0",
    "@sanity/table": "^2.0.1",
    "@sanity/vision": "5.31.1",
    "graphql": "^16.12.0",
    "react": "^19.1",
    "react-dom": "^19.1",
    "sanity": "^6.1.0",
    "sanity-plugin-graphiql": "^1.7.1",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.1",
    "eslint": "^9.28",
    "typescript": "^6.0"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  }
