{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": {
    "packages": [
      "studio"
    ],
    "nohoist": [
      "**/sanity",
      "**/@sanity/**",
      "**/sanity-plugin-graphiql"
    ]
  },
  "scripts": {
    "build": "next build --webpack",
    "build-studio": "yarn workspace studio build",
    "ci": "yarn ci:lint && yarn ci:test && yarn ci:typecheck && yarn ci:lighthouse && yarn ci:build",
    "ci:build": "yarn build && yarn build-studio",
    "ci:lighthouse": "yarn lhci:mobile && yarn lhci:desktop",
    "ci:lint": "yarn lint && yarn lint-studio",
    "ci:test": "yarn test:unit && yarn test:e2e && yarn test:e2e:pageviews",
    "ci:typecheck": "yarn typecheck && yarn typecheck-studio",
    "deploy-graphql": "yarn workspace studio deploy-graphql",
    "deploy-studio": "yarn workspace studio deploy",
    "dev": "next dev",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pageviews": "playwright test --config playwright.pageviews.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:visual": "playwright test visual.spec.ts --workers=1",
    "test:e2e:visual:update": "playwright test visual.spec.ts --workers=1 --update-snapshots",
    "generate-build-version": "node scripts/generate-build-version.mjs",
    "generate-types": "yarn workspace studio generate-types && mv studio/sanity.types.ts src/types/sanity.types.ts",
    "lint": "eslint",
    "lint:changed": "node scripts/lint-changed.mjs",
    "lint-studio": "yarn workspace studio lint",
    "lhci:mobile": "lhci autorun --upload.githubStatusContextSuffix=-mobile",
    "lhci:desktop": "lhci autorun --collect.settings.preset=desktop --upload.githubStatusContextSuffix=-desktop",
    "prebuild": "yarn generate-build-version",
    "predev": "yarn generate-build-version",
    "prepare": "husky",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc",
    "typecheck-studio": "yarn workspace studio typecheck",
    "migrate:topics": "node --env-file-if-exists=.env --env-file-if-exists=studio/.env scripts/migrate-blog-topics.mts"
  },
  "dependencies": {
    "@apollo/client": "^4.3.1",
    "@apollo/client-integration-nextjs": "^0.14.3",
    "@next/third-parties": "^16.3.8",
    "@sanity/code-input": "^7.0.12",
    "@sanity/image-url": "^2.0.2",
    "@sanity/table": "^3.1.17",
    "@sanity/vision": "^6.17.0",
    "clsx": "^2.1.1",
    "graphql": "^17.0.1",
    "next": "16.3.7",
    "next-sanity": "^13.3.4",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-loading-skeleton": "^3.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanity": "^6.17.0",
    "sanity-plugin-graphiql": "^1.7.1",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@sanity/eslint-config-studio": "^6.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.6",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "pinst": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^5.0.3"
  },
  "resolutions": {
    "styled-components": "^6.4.1",
    "prismjs": "^1.30.0",
    "smol-toml": "^1.6.1",
    "skills": "1.5.18",
    "**/adm-zip": "0.6.1",
    "**/@module-federation/dts-plugin/undici": "7.29.1",
    "**/@vercel/frameworks/js-yaml": "3.15.2",
    "**/markdown-it": "14.3.1",
    "**/linkify-it": "5.0.2",
    "**/tmp": "0.2.7",
    "**/@lhci/cli/uuid": "11.1.1",
    "**/typeid-js/uuid": "11.1.1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "browserslist": {
    "production": [
      "chrome >= 80",
      "edge >= 80",
      "firefox >= 74",
      "safari >= 13.1",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
