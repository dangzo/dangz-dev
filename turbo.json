{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#lint": {
      "outputs": []
    },
    "//#build": {
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    }
  }
}
